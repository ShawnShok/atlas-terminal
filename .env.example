# Local development defaults to deterministic mock data and makes no Massive calls.
USE_MOCK_DATA=true

# Required only when USE_MOCK_DATA=false. Never prefix server secrets with NEXT_PUBLIC_ or VITE_.
MASSIVE_API_KEY=
MASSIVE_API_BASE_URL=https://api.massive.com
MASSIVE_REQUEST_TIMEOUT_MS=10000
MASSIVE_MAX_RETRIES=2
MASSIVE_RETRY_BASE_DELAY_MS=250

# PostgreSQL connection. Use a pooled serverless URL in hosted environments.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas_terminal?schema=public

# Cache TTLs in milliseconds. The default adapter is bounded and process-local;
# a distributed Redis adapter can implement the same CacheStore contract later.
MEMORY_CACHE_MAX_ENTRIES=2000
CACHE_TTL_QUOTE_MS=5000
CACHE_TTL_INTRADAY_MS=15000
CACHE_TTL_OPTIONS_MS=30000
CACHE_TTL_NEWS_MS=30000
CACHE_TTL_EVENTS_MS=900000
CACHE_TTL_REFERENCE_MS=86400000
CACHE_TTL_FINANCIALS_MS=21600000
CACHE_TTL_HISTORICAL_MS=86400000
CACHE_STALE_IF_ERROR_MS=300000
